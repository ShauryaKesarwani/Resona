# Copy to server/.env.ens. Keep the private key in this server-only file.
ENS_RPC_URL=https://YOUR_SEPOLIA_RPC
# Public ENSNode instance for ENSv2 Sepolia name/address lookups.
ENSNODE_URL=https://api.v2-sepolia.ensnode.io
# Needed for deploy, link, and issue. Omit for inspect and transfer-check.
ENS_PRIVATE_KEY=
ENS_EVENT_NAME=YOUR_EVENT.eth
ENS_PARENT_REGISTRY=0xCURRENT_ENSV2_ETH_REGISTRY
ENS_FACTORY=0xCURRENT_VERIFIABLE_FACTORY
ENS_USER_REGISTRY_IMPL=0xCURRENT_USER_REGISTRY_IMPLEMENTATION
# Leave blank for the first deploy; fill from the deploy command output afterward.
ENS_EVENT_REGISTRY=
