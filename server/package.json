{
  "name": "resona-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env --env-file-if-exists=.env.arkiv src/index.ts",
    "start": "tsx --env-file=.env --env-file-if-exists=.env.arkiv src/index.ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "arkiv:setup": "tsx src/arkiv/setup.ts",
    "arkiv:event": "tsx --env-file=.env --env-file-if-exists=.env.arkiv src/arkiv/create-event.ts",
    "arkiv:spike": "node --env-file=.env.arkiv --import tsx src/arkiv/spike.ts"
  },
  "dependencies": {
    "@arkiv-network/sdk": "^1.0.1",
    "@worldcoin/idkit-core": "^4.6.0",
    "express": "^5.3.0",
    "tsx": "^4.23.15",
    "viem": "^2.57.16"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
