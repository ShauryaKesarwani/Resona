PORT=3050
# Testnet-only organizer account. Keep both values server-side.
ARKIV_PRIVATE_KEY=
ARKIV_ACCESS_KEY=
# Comma-separated wallets allowed to issue tickets. If empty, nobody can.
ORGANIZER_WALLETS=
# Stable identifier of the event that organizer-issued tickets belong to.
ARKIV_EVENT_ID=demo-event
WORLD_APP_ID=
WORLD_RP_ID=
# Server only. Never prefix with VITE_, and never log it.
RP_SIGNING_KEY=
# The World ID first sign-in action. A person can only use an action once; later sign-ins use their World session.
WORLD_ACTION=signin-resona-session
# staging = simulator, production = real World App
WORLD_ENV=staging
# Secret for hashing nullifiers before they reach Arkiv. Never change it, or lookups stop matching.
NULLIFIER_HASH_KEY=
# Door phones enter this once. Without it, anyone could act as the door for their own ticket.
DOOR_PIN=
# Demo only: shows the Skip button on the sign-in page.
ALLOW_WORLD_SKIP=true
# ENS pass reads, door enforcement, and organizer-approved transfers. Transfers also need a signer with registry roles.
ENS_ENABLED=false
ENS_RPC_URL=
ENS_EVENT_NAME=
ENS_PARENT_REGISTRY=
ENS_EVENT_REGISTRY=
ENS_PRIVATE_KEY=
ENSNODE_URL=https://api.v2-sepolia.ensnode.io
